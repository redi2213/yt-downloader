{
  "config_version": 21,
  "actions": [
    {
      "id": "tiktok_download",
      "title": "Download from TikTok",
      "icon": "tiktok",
      "enabled": true,
      "domains": [
        "tiktok.com"
      ],
      "input_type": "url",
      "input_hint": "Enter the TikTok video link",
      "workflow": "Any-Site-Upload.yml",
      "workflow_inputs": {
        "mode": "release",
        "urls": "{input}",
        "quality": "highest"
      }
    },
    {
      "id": "any_site_upload",
      "title": "Any site (extract & upload)",
      "icon": "download",
      "enabled": true,
      "fields": [
        {
          "key": "urls",
          "type": "text",
          "label": "Video links (one per line)",
          "hint": "Paste one or more page links",
          "multiline": true
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Check formats",
              "value": "check"
            },
            {
              "label": "Highest",
              "value": "highest"
            },
            {
              "label": "1080p",
              "value": "1080"
            },
            {
              "label": "720p",
              "value": "720"
            },
            {
              "label": "480p",
              "value": "480"
            },
            {
              "label": "360p",
              "value": "360"
            },
            {
              "label": "240p",
              "value": "240"
            },
            {
              "label": "144p",
              "value": "144"
            }
          ],
          "default": "720"
        }
      ],
      "workflow": "Any-Site-Upload.yml",
      "workflow_inputs": {
        "mode": "release",
        "urls": "{urls}",
        "quality": "{quality}"
      },
      "handler": "anysite",
      "group": "upload"
    },
    {
      "id": "drive_to_release",
      "title": "Google Drive to release",
      "icon": "download",
      "enabled": true,
      "domains": [
        "drive.google.com"
      ],
      "group": "upload",
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Google Drive file link",
          "hint": "https://drive.google.com/file/d/.../view"
        }
      ],
      "workflow": "drive-to-release.yml",
      "workflow_inputs": {
        "drive_url": "{url}"
      }
    },
    {
      "id": "series_links",
      "title": "Series links (from one episode link)",
      "icon": "download",
      "enabled": true,
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "One episode link",
          "hint": "Put a * where the episode number is (optional)"
        },
        {
          "key": "from_ep",
          "type": "text",
          "label": "First episode",
          "hint": "1   (type 01 to keep the zero when you use *)"
        },
        {
          "key": "to_ep",
          "type": "text",
          "label": "Last episode",
          "hint": "5   (up to 100 episodes per run)"
        },
        {
          "key": "season",
          "type": "choice",
          "label": "Season (replaces S01 in the link)",
          "choices": [
            {
              "label": "Keep as in link",
              "value": ""
            },
            {
              "label": "1",
              "value": "1"
            },
            {
              "label": "2",
              "value": "2"
            },
            {
              "label": "3",
              "value": "3"
            },
            {
              "label": "4",
              "value": "4"
            },
            {
              "label": "5",
              "value": "5"
            },
            {
              "label": "6",
              "value": "6"
            },
            {
              "label": "7",
              "value": "7"
            },
            {
              "label": "8",
              "value": "8"
            },
            {
              "label": "9",
              "value": "9"
            },
            {
              "label": "10",
              "value": "10"
            }
          ],
          "default": ""
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "What do you want?",
          "choices": [
            {
              "label": "Links only",
              "value": "links"
            },
            {
              "label": "Links + upload files",
              "value": "upload"
            }
          ],
          "default": "links"
        },
        {
          "key": "check",
          "type": "choice",
          "label": "Check that every link works",
          "choices": [
            {
              "label": "Yes",
              "value": "true"
            },
            {
              "label": "No",
              "value": "false"
            }
          ],
          "default": "true"
        },
        {
          "key": "zip_it",
          "type": "choice",
          "label": "Upload mode: zip each file",
          "choices": [
            {
              "label": "No",
              "value": "false"
            },
            {
              "label": "Yes",
              "value": "true"
            }
          ],
          "default": "false"
        }
      ],
      "workflow": "Series-Links.yml",
      "workflow_inputs": {
        "url": "{url}",
        "from_ep": "{from_ep}",
        "to_ep": "{to_ep}",
        "season": "{season}",
        "mode": "{mode}",
        "check": "{check}",
        "zip_it": "{zip_it}"
      }
    },
    {
      "id": "aparat_download",
      "title": "Download from Aparat",
      "icon": "aparat",
      "enabled": true,
      "domains": [
        "aparat.com"
      ],
      "handler": "aparat",
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Aparat link",
          "hint": "Video, playlist or channel link"
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Best",
              "value": "best"
            },
            {
              "label": "1080p",
              "value": "1080p"
            },
            {
              "label": "720p",
              "value": "720p"
            },
            {
              "label": "480p",
              "value": "480p"
            },
            {
              "label": "360p",
              "value": "360p"
            },
            {
              "label": "240p",
              "value": "240p"
            },
            {
              "label": "144p",
              "value": "144p"
            }
          ],
          "default": "best"
        },
        {
          "key": "output",
          "type": "choice",
          "label": "Output",
          "choices": [
            {
              "label": "Upload files",
              "value": "upload_separate"
            },
            {
              "label": "Upload as one zip",
              "value": "upload_zip"
            },
            {
              "label": "Links only",
              "value": "links"
            },
            {
              "label": "Links on phone",
              "value": "links_phone"
            }
          ],
          "default": "upload_separate"
        },
        {
          "key": "channel_limit",
          "type": "choice",
          "label": "Channel: how many (tap one, or type your own)",
          "choices": [
            {
              "label": "Last 5 videos",
              "value": "count:5"
            },
            {
              "label": "Last 10 videos",
              "value": "count:10"
            },
            {
              "label": "Last 20 videos",
              "value": "count:20"
            },
            {
              "label": "Last 50 videos",
              "value": "count:50"
            },
            {
              "label": "Last 1 day",
              "value": "days:1"
            },
            {
              "label": "Last 7 days",
              "value": "days:7"
            },
            {
              "label": "Last 30 days",
              "value": "days:30"
            }
          ],
          "default": "count:5",
          "custom": {
            "units": [
              {
                "label": "Videos",
                "value": "count",
                "max": 200
              },
              {
                "label": "Days",
                "value": "days",
                "max": 365
              }
            ]
          }
        }
      ],
      "workflow": "aparat-download.yml",
      "workflow_inputs": {
        "aparat_url": "{url}",
        "quality": "{quality}",
        "output": "{output}",
        "channel_limit": "{channel_limit}",
        "video_ids": "{video_ids}"
      }
    },
    {
      "id": "telegram_download",
      "title": "Download from Telegram",
      "icon": "telegram",
      "enabled": true,
      "domains": [
        "t.me",
        "telegram.me",
        "telegram.dog"
      ],
      "input_type": "url",
      "input_hint": "Enter the Telegram message link",
      "workflow": "telegram-download.yml",
      "workflow_inputs": {
        "telegram_url": "{input}"
      }
    },
    {
      "id": "google_play_download",
      "title": "Download APK from Google Play",
      "icon": "google_play",
      "enabled": true,
      "domains": [
        "play.google.com"
      ],
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Google Play link",
          "hint": "https://play.google.com/store/apps/details?id=..."
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "Mode",
          "choices": [
            {
              "label": "Universal (everything)",
              "value": "universal"
            },
            {
              "label": "Optimized (one device type)",
              "value": "optimized"
            }
          ],
          "default": "universal"
        },
        {
          "key": "architecture",
          "type": "choice",
          "label": "Device type",
          "choices": [
            {
              "label": "arm64 (most phones)",
              "value": "arm64"
            },
            {
              "label": "armv7 (old 32-bit)",
              "value": "armv7"
            },
            {
              "label": "x86",
              "value": "x86"
            },
            {
              "label": "x86_64",
              "value": "x86_64"
            },
            {
              "label": "All (Universal only)",
              "value": "all"
            }
          ],
          "default": "arm64"
        },
        {
          "key": "android",
          "type": "choice",
          "label": "Your Android version (only used to warn)",
          "choices": [
            {
              "label": "Don't check",
              "value": ""
            },
            {
              "label": "Android 16",
              "value": "16"
            },
            {
              "label": "Android 15",
              "value": "15"
            },
            {
              "label": "Android 14",
              "value": "14"
            },
            {
              "label": "Android 13",
              "value": "13"
            },
            {
              "label": "Android 12",
              "value": "12"
            },
            {
              "label": "Android 11",
              "value": "11"
            },
            {
              "label": "Android 10",
              "value": "10"
            },
            {
              "label": "Android 9",
              "value": "9"
            },
            {
              "label": "Android 8",
              "value": "8"
            }
          ],
          "default": ""
        },
        {
          "key": "locales",
          "type": "choice",
          "label": "Extra languages (English is always included)",
          "choices": [
            {
              "label": "English only",
              "value": ""
            },
            {
              "label": "Persian",
              "value": "fa"
            },
            {
              "label": "Arabic",
              "value": "ar"
            },
            {
              "label": "Persian + Arabic",
              "value": "fa,ar"
            }
          ],
          "default": ""
        },
        {
          "key": "output",
          "type": "choice",
          "label": "Output",
          "choices": [
            {
              "label": "Standard (apk / apks / xapk)",
              "value": "standard"
            },
            {
              "label": "ZIP",
              "value": "zip"
            }
          ],
          "default": "standard"
        }
      ],
      "workflow": "google-play-download.yml",
      "workflow_inputs": {
        "stage": "download",
        "play_url": "{url}",
        "mode": "{mode}",
        "architecture": "{architecture}",
        "android_version": "{android}",
        "output_format": "{output}",
        "locales": "{locales}"
      }
    },
    {
      "id": "filimo",
      "title": "Filimo",
      "icon": "filimo",
      "enabled": true,
      "domains": [
        "filimo.com"
      ],
      "handler": "filimo_phone",
      "workflow": "filimo-direct-link.yml",
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Filimo link",
          "hint": "Movie or episode link (or item ID)"
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "What do you want?",
          "choices": [
            {
              "label": "Get link (phone network)",
              "value": "phone"
            },
            {
              "label": "Download to GitHub Release",
              "value": "release"
            }
          ],
          "default": "phone"
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Best",
              "value": "Best available"
            },
            {
              "label": "1080p",
              "value": "1080p"
            },
            {
              "label": "720p",
              "value": "720p"
            },
            {
              "label": "480p",
              "value": "480p"
            }
          ],
          "default": "480p"
        },
        {
          "key": "subtitle",
          "type": "choice",
          "label": "Subtitle (download mode only)",
          "choices": [
            {
              "label": "None",
              "value": "none"
            },
            {
              "label": "Persian",
              "value": "Persian"
            }
          ],
          "default": "none"
        }
      ],
      "workflow_inputs": {
        "url": "{url}",
        "quality": "{quality}",
        "subtitle": "{subtitle}",
        "output_mode": "GitHub Release"
      }
    },
    {
      "id": "mornye",
      "title": "Mornye (Spotify lossless)",
      "icon": "download",
      "enabled": true,
      "domains": [
        "open.spotify.com"
      ],
      "handler": "mornye_phone",
      "workflow": "mornye-download.yml",
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Spotify link",
          "hint": "Track, album, playlist or artist link"
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Lossless (FLAC)",
              "value": "LOSSLESS"
            }
          ],
          "default": "LOSSLESS"
        },
        {
          "key": "providers",
          "type": "choice",
          "label": "Sources (in order)",
          "choices": [
            {
              "label": "Tidal, Qobuz, Deezer",
              "value": "tidal,qobuz,deezer"
            },
            {
              "label": "Qobuz, Tidal, Deezer",
              "value": "qobuz,tidal,deezer"
            },
            {
              "label": "Deezer, Tidal, Qobuz",
              "value": "deezer,tidal,qobuz"
            }
          ],
          "default": "tidal,qobuz,deezer"
        },
        {
          "key": "target",
          "type": "choice",
          "label": "Where to keep the files",
          "choices": [
            {
              "label": "On this phone",
              "value": "phone"
            },
            {
              "label": "Upload to GitHub release",
              "value": "github"
            }
          ],
          "default": "phone"
        }
      ],
      "workflow_inputs": {
        "spotify_url": "{url}",
        "quality": "{quality}"
      }
    }
  ],
  "error_help": [
    {
      "id": "bot_check",
      "match": [
        "not a bot",
        "sign in to confirm",
        "confirm you’re not a bot",
        "use --cookies"
      ],
      "title": "یوتیوب می‌گه ربات هستی",
      "tip": "کوکی یوتیوب منقضی یا نامعتبر شده. Secret با نام YTDLP_COOKIES را با کوکی تازه (فرمت Netscape) به‌روز کن و دوباره اجرا کن."
    },
    {
      "id": "private_video",
      "match": [
        "private video",
        "video is private",
        "video unavailable",
        "has been removed",
        "this video is not available",
        "account associated with this video has been terminated"
      ],
      "title": "ویدیو خصوصی یا حذف شده",
      "tip": "ویدیو قابل دسترس نیست. لینک را در مرورگر باز کن تا ببینی همچنان موجود است."
    },
    {
      "id": "age_restricted",
      "match": [
        "age-restricted",
        "confirm your age",
        "inappropriate for some users"
      ],
      "title": "محدودیت سنی",
      "tip": "برای این ویدیو ورود با حساب لازم است. کوکی تازهٔ یوتیوب در Secret با نام YTDLP_COOKIES بگذار."
    },
    {
      "id": "geo_block",
      "match": [
        "not available in your country",
        "blocked it in your country",
        "geo restricted",
        "geo-restricted",
        "who has blocked it"
      ],
      "title": "محدودیت جغرافیایی",
      "tip": "این محتوا از سرورهای گیت‌هاب قابل دسترس نیست. اگر سایت اجازه می‌دهد، دکمهٔ «لینک از روی گوشی» را امتحان کن."
    },
    {
      "id": "live_event",
      "match": [
        "live event will begin",
        "premieres in",
        "this live event",
        "is upcoming"
      ],
      "title": "هنوز پخش نشده",
      "tip": "این ویدیو پرمیر یا پخش زنده آینده است. بعد از پخش شدن دوباره امتحان کن."
    },
    {
      "id": "token_invalid",
      "match": [
        "bad credentials",
        "token is invalid",
        "github token invalid",
        "re:\\bhttp 401\\b",
        "re:\\b401\\b.*unauthorized",
        "resource not accessible by"
      ],
      "title": "توکن گیت‌هاب نامعتبر یا بدون اجازه",
      "tip": "توکن منقضی شده یا دسترسی کافی ندارد. از Settings توکن تازه بگذار یا دوباره با GitHub وارد شو (صفحهٔ Health هم وضعیت توکن را نشان می‌دهد)."
    },
    {
      "id": "link_expired",
      "match": [
        "url has expired",
        "link has expired",
        "link expired",
        "signature has expired",
        "token expired",
        "re:\\bhttp error 410\\b",
        "re:\\b410\\b.*gone",
        "expired"
      ],
      "title": "لینک منقضی شده",
      "tip": "لینک موقت بود و منقضی شده. لینک تازه بگیر و دوباره اجرا کن («Run again» لینک قدیمی را دوباره می‌فرستد)."
    },
    {
      "id": "http_403",
      "match": [
        "re:\\bhttp error 403\\b",
        "re:\\b403\\b.*forbidden",
        "forbidden",
        "re:\\bstatus code:? 403\\b"
      ],
      "title": "دسترسی رد شد (403)",
      "tip": "سایت درخواست را رد کرده: لینک منقضی، محدودیت سرور یا نیاز به کوکی. لینک تازه بگیر، کمی بعد دوباره امتحان کن یا کیفیت را عوض کن."
    },
    {
      "id": "http_404",
      "match": [
        "re:\\bhttp error 404\\b",
        "re:\\b404\\b.*not found",
        "re:\\bstatus code:? 404\\b"
      ],
      "title": "صفحه یا فایل پیدا نشد (404)",
      "tip": "لینک اشتباه است یا محتوا حذف شده. لینک را در مرورگر باز کن و درست‌ش کن."
    },
    {
      "id": "rate_limit",
      "match": [
        "re:\\b429\\b",
        "too many requests",
        "rate limit",
        "rate-limit"
      ],
      "title": "درخواست بیش از حد (429)",
      "tip": "سایت یا گیت‌هاب موقتاً محدودت کرده. چند دقیقه صبر کن و دوباره اجرا کن (چند لینک را کمتر هم‌زمان بفرس)."
    },
    {
      "id": "no_ffmpeg",
      "match": [
        "ffmpeg not found",
        "ffmpeg is not installed",
        "ffprobe and ffmpeg not found",
        "ffmpeg: command not found",
        "ffmpeg: not found"
      ],
      "title": "ffmpeg پیدا نشد",
      "tip": "نصب ffmpeg در ورک‌فلو ناموفق بوده (معمولاً مشکل موقت دانلود). یک‌بار دیگر اجرا کن؛ اگر تکرار شد مرحلهٔ «Install ffmpeg» در لاگ را ببین."
    },
    {
      "id": "timeout",
      "match": [
        "timed out",
        "timed_out",
        "timeout",
        "exceeded the maximum execution time",
        "operation was canceled",
        "the operation was cancelled"
      ],
      "title": "زمان اجرا تمام شد (تایم‌اوت)",
      "tip": "کار از مدت مجاز طولانی‌تر شد. کیفیت پایین‌تر برای فایل بزرگ انتخاب کن، یا فایل‌ها را جدا و کم‌تعدادتر دانلود کن."
    },
    {
      "id": "no_space",
      "match": [
        "no space left on device",
        "disk quota exceeded"
      ],
      "title": "جای دیسک رانر تمام شد",
      "tip": "فایل آنقدر بزرگ است که جا نمی‌شود. کیفیت پایین‌تر انتخاب کن یا فایل‌ها را به چند اجرای جدا تقسیم کن."
    },
    {
      "id": "too_large",
      "match": [
        "file size exceeds",
        "larger than 2",
        "asset size",
        "re:\\bsize\\b.*\\b2\\s?gb\\b",
        "too large",
        "re:\\b413\\b"
      ],
      "title": "فایل از ۲ گیگ بیشتر است",
      "tip": "گیت‌هاب فایل بیش از ۲ گیگابایت را در ریلیز نمی‌پذیرد. کیفیت پایین‌تر انتخاب کن یا ذخیره‌سازی آروان (Storage) را امتحان کن."
    },
    {
      "id": "no_format",
      "match": [
        "requested format is not available",
        "no video formats found",
        "format is not available",
        "no formats found"

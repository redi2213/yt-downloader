{
  "config_version": 5,
  "actions": [
    {
      "id": "youtube_generic",
      "title": "Download from YouTube (Anything)",
      "icon": "youtube",
      "enabled": true,
      "input_type": "url",
      "input_hint": "Enter the YouTube video link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "tiktok_download",
      "title": "Download from TikTok",
      "icon": "tiktok",
      "enabled": true,
      "domains": [
        "tiktok.com"
      ],
      "input_type": "url",
      "input_hint": "Enter the TikTok video link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "mediafire_download",
      "title": "Download from Mediafire",
      "icon": "mediafire",
      "enabled": true,
      "domains": [
        "mediafire.com"
      ],
      "input_type": "url",
      "input_hint": "Enter the Mediafire link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "aparat_download",
      "title": "Download from Aparat",
      "icon": "aparat",
      "enabled": true,
      "domains": [
        "aparat.com"
      ],
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Aparat link",
          "hint": "Video, playlist or channel link"
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Best",
              "value": "best"
            },
            {
              "label": "1080p",
              "value": "1080p"
            },
            {
              "label": "720p",
              "value": "720p"
            },
            {
              "label": "480p",
              "value": "480p"
            },
            {
              "label": "360p",
              "value": "360p"
            },
            {
              "label": "240p",
              "value": "240p"
            },
            {
              "label": "144p",
              "value": "144p"
            }
          ],
          "default": "best"
        },
        {
          "key": "output",
          "type": "choice",
          "label": "Output",
          "choices": [
            {
              "label": "Upload files",
              "value": "upload_separate"
            },
            {
              "label": "Upload as one zip",
              "value": "upload_zip"
            },
            {
              "label": "Links only",
              "value": "links"
            }
          ],
          "default": "upload_separate"
        },
        {
          "key": "channel_limit",
          "type": "choice",
          "label": "Channel: how many",
          "choices": [
            {
              "label": "Last 5 videos",
              "value": "count:5"
            },
            {
              "label": "Last 10 videos",
              "value": "count:10"
            },
            {
              "label": "Last 20 videos",
              "value": "count:20"
            },
            {
              "label": "Last 50 videos",
              "value": "count:50"
            },
            {
              "label": "Last 1 day",
              "value": "days:1"
            },
            {
              "label": "Last 7 days",
              "value": "days:7"
            },
            {
              "label": "Last 30 days",
              "value": "days:30"
            }
          ],
          "default": "count:5"
        }
      ],
      "workflow": "aparat-download.yml",
      "workflow_inputs": {
        "aparat_url": "{url}",
        "quality": "{quality}",
        "output": "{output}",
        "channel_limit": "{channel_limit}"
      }
    },
    {
      "id": "telegram_download",
      "title": "Download from Telegram",
      "icon": "telegram",
      "enabled": true,
      "domains": [
        "t.me",
        "telegram.me",
        "telegram.dog"
      ],
      "input_type": "url",
      "input_hint": "Enter the Telegram message link",
      "workflow": "telegram-download.yml",
      "workflow_inputs": {
        "telegram_url": "{input}"
      }
    },
    {
      "id": "google_play_download",
      "title": "Google Play Downloader",
      "icon": "google_play",
      "enabled": true,
      "fields": [
        {
          "key": "stage",
          "type": "choice",
          "label": "Stage",
          "choices": [
            {
              "label": "Inspect (look only)",
              "value": "inspect"
            },
            {
              "label": "Download",
              "value": "download"
            }
          ],
          "default": "inspect"
        },
        {
          "key": "play_url",
          "type": "text",
          "label": "Google Play link",
          "hint": "Google Play link or package name"
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "Mode",
          "choices": [
            {
              "label": "Universal",
              "value": "universal"
            },
            {
              "label": "Optimized",
              "value": "optimized"
            }
          ],
          "default": "universal"
        },
        {
          "key": "architecture",
          "type": "choice",
          "label": "Device type",
          "choices": [
            {
              "label": "ARM64",
              "value": "arm64"
            },
            {
              "label": "ARMv7",
              "value": "armv7"
            },
            {
              "label": "x86",
              "value": "x86"
            },
            {
              "label": "x86_64",
              "value": "x86_64"
            },
            {
              "label": "All",
              "value": "all"
            }
          ],
          "default": "arm64"
        },
        {
          "key": "android_version",
          "type": "text",
          "label": "Android version (optional)",
          "hint": "Optional: 5-16",
          "default": ""
        },
        {
          "key": "locales",
          "type": "text",
          "label": "Extra languages (optional)",
          "hint": "Optional, e.g. de,fr,zh-CN. English is always included.",
          "default": ""
        },
        {
          "key": "output_format",
          "type": "choice",
          "label": "Output format",
          "choices": [
            {
              "label": "Standard (APK / APKS / XAPK)",
              "value": "standard"
            },
            {
              "label": "ZIP (everything in one ZIP)",
              "value": "zip"
            }
          ],
          "default": "standard"
        }
      ],
      "workflow": "google-play-download.yml",
      "workflow_inputs": {
        "stage": "{stage}",
        "play_url": "{play_url}",
        "mode": "{mode}",
        "architecture": "{architecture}",
        "android_version": "{android_version}",
        "locales": "{locales}",
        "output_format": "{output_format}",
        "job_id": "",
        "run_title": "Google Play Downloader"
      }
    }
  ]
}

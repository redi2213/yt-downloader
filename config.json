{
  "config_version": 7,
  "actions": [
    {
      "id": "youtube_generic",
      "title": "Download from YouTube (Anything)",
      "icon": "youtube",
      "enabled": true,
      "input_type": "url",
      "input_hint": "Enter the YouTube video link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "tiktok_download",
      "title": "Download from TikTok",
      "icon": "tiktok",
      "enabled": true,
      "domains": [
        "tiktok.com"
      ],
      "input_type": "url",
      "input_hint": "Enter the TikTok video link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "mediafire_download",
      "title": "Download from Mediafire",
      "icon": "mediafire",
      "enabled": true,
      "domains": [
        "mediafire.com"
      ],
      "input_type": "url",
      "input_hint": "Enter the Mediafire link",
      "workflow": "download-anything.yml",
      "workflow_inputs": {
        "url": "{input}",
        "mode": "upload_release",
        "format_id": "bv*+ba/best",
        "audio_only": "false"
      }
    },
    {
      "id": "aparat_download",
      "title": "Download from Aparat",
      "icon": "aparat",
      "enabled": true,
      "domains": [
        "aparat.com"
      ],
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Aparat link",
          "hint": "Video, playlist or channel link"
        },
        {
          "key": "quality",
          "type": "choice",
          "label": "Quality",
          "choices": [
            {
              "label": "Best",
              "value": "best"
            },
            {
              "label": "1080p",
              "value": "1080p"
            },
            {
              "label": "720p",
              "value": "720p"
            },
            {
              "label": "480p",
              "value": "480p"
            },
            {
              "label": "360p",
              "value": "360p"
            },
            {
              "label": "240p",
              "value": "240p"
            },
            {
              "label": "144p",
              "value": "144p"
            }
          ],
          "default": "best"
        },
        {
          "key": "output",
          "type": "choice",
          "label": "Output",
          "choices": [
            {
              "label": "Upload files",
              "value": "upload_separate"
            },
            {
              "label": "Upload as one zip",
              "value": "upload_zip"
            },
            {
              "label": "Links only",
              "value": "links"
            }
          ],
          "default": "upload_separate"
        },
        {
          "key": "channel_limit",
          "type": "choice",
          "label": "Channel: how many (tap one, or type your own)",
          "choices": [
            {
              "label": "Last 5 videos",
              "value": "count:5"
            },
            {
              "label": "Last 10 videos",
              "value": "count:10"
            },
            {
              "label": "Last 20 videos",
              "value": "count:20"
            },
            {
              "label": "Last 50 videos",
              "value": "count:50"
            },
            {
              "label": "Last 1 day",
              "value": "days:1"
            },
            {
              "label": "Last 7 days",
              "value": "days:7"
            },
            {
              "label": "Last 30 days",
              "value": "days:30"
            }
          ],
          "default": "count:5",
          "custom": {
            "units": [
              {
                "label": "Videos",
                "value": "count",
                "max": 200
              },
              {
                "label": "Days",
                "value": "days",
                "max": 365
              }
            ]
          }
        }
      ],
      "workflow": "aparat-download.yml",
      "workflow_inputs": {
        "aparat_url": "{url}",
        "quality": "{quality}",
        "output": "{output}",
        "channel_limit": "{channel_limit}"
      }
    },
    {
      "id": "telegram_download",
      "title": "Download from Telegram",
      "icon": "telegram",
      "enabled": true,
      "domains": [
        "t.me",
        "telegram.me",
        "telegram.dog"
      ],
      "input_type": "url",
      "input_hint": "Enter the Telegram message link",
      "workflow": "telegram-download.yml",
      "workflow_inputs": {
        "telegram_url": "{input}"
      }
    },
    {
      "id": "google_play_download",
      "title": "Download APK from Google Play",
      "icon": "google_play",
      "enabled": true,
      "domains": [
        "play.google.com"
      ],
      "fields": [
        {
          "key": "url",
          "type": "text",
          "label": "Google Play link",
          "hint": "https://play.google.com/store/apps/details?id=..."
        },
        {
          "key": "mode",
          "type": "choice",
          "label": "Mode",
          "choices": [
            {
              "label": "Universal (everything)",
              "value": "universal"
            },
            {
              "label": "Optimized (one device type)",
              "value": "optimized"
            }
          ],
          "default": "universal"
        },
        {
          "key": "architecture",
          "type": "choice",
          "label": "Device type",
          "choices": [
            {
              "label": "arm64 (most phones)",
              "value": "arm64"
            },
            {
              "label": "armv7 (old 32-bit)",
              "value": "armv7"
            },
            {
              "label": "x86",
              "value": "x86"
            },
            {
              "label": "x86_64",
              "value": "x86_64"
            },
            {
              "label": "All (Universal only)",
              "value": "all"
            }
          ],
          "default": "arm64"
        },
        {
          "key": "android",
          "type": "choice",
          "label": "Your Android version (only used to warn)",
          "choices": [
            {
              "label": "Don't check",
              "value": ""
            },
            {
              "label": "Android 16",
              "value": "16"
            },
            {
              "label": "Android 15",
              "value": "15"
            },
            {
              "label": "Android 14",
              "value": "14"
            },
            {
              "label": "Android 13",
              "value": "13"
            },
            {
              "label": "Android 12",
              "value": "12"
            },
            {
              "label": "Android 11",
              "value": "11"
            },
            {
              "label": "Android 10",
              "value": "10"
            },
            {
              "label": "Android 9",
              "value": "9"
            },
            {
              "label": "Android 8",
              "value": "8"
            }
          ],
          "default": ""
        },
        {
          "key": "locales",
          "type": "choice",
          "label": "Extra languages (English is always included)",
          "choices": [
            {
              "label": "English only",
              "value": ""
            },
            {
              "label": "Persian",
              "value": "fa"
            },
            {
              "label": "Arabic",
              "value": "ar"
            },
            {
              "label": "Persian + Arabic",
              "value": "fa,ar"
            }
          ],
          "default": ""
        },
        {
          "key": "output",
          "type": "choice",
          "label": "Output",
          "choices": [
            {
              "label": "Standard (apk / apks / xapk)",
              "value": "standard"
            },
            {
              "label": "ZIP",
              "value": "zip"
            }
          ],
          "default": "standard"
        }
      ],
      "workflow": "google-play-download.yml",
      "workflow_inputs": {
        "stage": "download",
        "play_url": "{url}",
        "mode": "{mode}",
        "architecture": "{architecture}",
        "android_version": "{android}",
        "output_format": "{output}",
        "locales": "{locales}"
      }
    }
  ]
}
